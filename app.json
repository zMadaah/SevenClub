{
  "expo": {
    "name": "Seven Club",
    "slug": "seven-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#96998c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sevenclub.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O Seven Club usa sua localização para registrar suas corridas, rotas e distância percorrida.",
        "NSPhotoLibraryUsageDescription": "O Seven Club acessa suas fotos para você escolher uma imagem de perfil ou de fundo ao compartilhar uma atividade.",
        "NSPhotoLibraryAddUsageDescription": "O Seven Club salva na sua galeria a imagem gerada ao compartilhar uma atividade."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#e9ebe6"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.sevenclub.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#BCFF00"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O Seven Club acessa suas fotos para você escolher uma imagem de perfil ou de fundo ao compartilhar uma atividade.",
          "savePhotosPermission": "O Seven Club salva na sua galeria a imagem gerada ao compartilhar uma atividade.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8e1270d0-07b2-4dbf-8ce3-99bf19af9a2d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8e1270d0-07b2-4dbf-8ce3-99bf19af9a2d"
    }
  }
}
