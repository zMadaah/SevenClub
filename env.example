# Copie para .env na raiz do projeto. Variáveis EXPO_PUBLIC_* ficam
# embutidas no bundle e acessíveis via process.env no código do app.
#
# Testando no emulador Android: 10.0.2.2 é como o emulador enxerga o
# "localhost" da sua máquina. No iOS Simulator, localhost funciona direto.
# Testando num celular físico (Expo Go): use o IP da sua máquina na rede
# local (ex: 192.168.0.10), não localhost — o celular não é a mesma máquina.
EXPO_PUBLIC_API_URL=http://localhost:3333
